---
import Layout from "@/layouts/Layout.astro";
import ProjectsCatalog from "@/components/pages/ProjectsCatalog.astro";
import { getPaginatedProjects } from "@/utils/projects";

const currentPage = 1;
const projectsPerPage = 6;

const paginatedData = await getPaginatedProjects(currentPage, projectsPerPage);
---

<Layout
  head={{
    title: "All Projects",
    description:
      "Browse all backend development projects including APIs, microservices, databases, and distributed systems.",
  }}
>
  <ProjectsCatalog currentPage={currentPage} paginatedData={paginatedData} />
</Layout>
