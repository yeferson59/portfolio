---
import Layout from "@/layouts/Layout.astro";
import ProjectsCatalog from "@/components/pages/ProjectsCatalog.astro";
import { getPaginatedProjects } from "@/utils/projects";

export const prerender = true;

// Get static paths for all pages
export async function getStaticPaths() {
  const projectsPerPage = 6;
  const allPaginatedData = await getPaginatedProjects(1, projectsPerPage);
  const totalPages = allPaginatedData.totalPages;

  // Generate paths for all pages except page 1 (handled by projects.astro)
  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    const paginatedData = await getPaginatedProjects(page, projectsPerPage);
    paths.push({
      params: { page: page.toString() },
      props: { paginatedData },
    });
  }

  return paths;
}

const { paginatedData } = Astro.props;
const currentPage = parseInt(Astro.params.page || "1");
const { totalPages } = paginatedData;
---

<Layout
  head={{
    title: `All Projects - Page ${currentPage}`,
    description: `Browse backend development projects - Page ${currentPage} of ${totalPages}. Including APIs, microservices, databases, and distributed systems.`,
  }}
>
  <ProjectsCatalog currentPage={currentPage} paginatedData={paginatedData} />
</Layout>
