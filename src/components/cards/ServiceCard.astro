---
import Button from "@/components/ui/Button.astro";

interface Props {
  name: string;
  subtitle: string;
  description: string;
  features: string[];
  cta: string;
  featured?: boolean;
  href?: string;
}

const {
  name,
  subtitle,
  description,
  features,
  cta,
  featured = false,
  href = "#contact",
} = Astro.props;
---

<!-- One row of the services index; the featured service starts open. -->
<details class="service" open={featured}>
  <summary class="service__summary">
    <span class="service__name">{name}</span>
    <span class="service__subtitle">{subtitle}</span>
    <span class="service__toggle" aria-hidden="true"></span>
  </summary>

  <div class="service__body">
    <p class="service__description">{description}</p>
    <ul class="service__features">
      {features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
    <Button variant={featured ? "primary" : "secondary"} href={href}>
      {cta}
    </Button>
  </div>
</details>

<style>
  .service {
    border-bottom: 1px solid var(--line-strong);
  }

  .service__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.75rem;
    gap: var(--space-xs) var(--space-xl);
    align-items: center;
    padding: var(--space-xl) 0;
    cursor: pointer;
    list-style: none;
  }

  .service__summary::-webkit-details-marker {
    display: none;
  }

  @media (min-width: 900px) {
    .service__summary {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr) 2.75rem;
    }
  }

  .service__name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-extrabold);
    font-variation-settings: "wdth" 60;
    font-size: clamp(1.75rem, 1.1rem + 2.2vw, 3rem);
    line-height: 1;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .service__subtitle {
    grid-row: 2;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .service__subtitle {
      grid-row: auto;
      font-size: var(--font-size-base);
    }
  }

  .service__toggle {
    grid-column: -2;
    grid-row: 1 / span 2;
    justify-self: end;
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  @media (min-width: 900px) {
    .service__toggle {
      grid-row: auto;
    }
  }

  .service__toggle::before,
  .service__toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    background: currentColor;
    color: var(--color-text-primary);
    transform: translate(-50%, -50%);
    transition: transform var(--transition-normal);
  }

  .service__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .service[open] .service__toggle {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .service[open] .service__toggle::before,
  .service[open] .service__toggle::after {
    color: var(--color-background);
    background: var(--color-background);
  }

  .service[open] .service__toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .service__summary:hover .service__name,
  .service[open] .service__name {
    color: var(--color-primary);
  }

  .service__summary:hover .service__toggle {
    border-color: var(--color-text-primary);
  }

  .service__body {
    display: grid;
    gap: var(--space-lg);
    padding-bottom: var(--space-2xl);
    justify-items: start;
  }

  @media (min-width: 900px) {
    .service__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: var(--space-xl);
      margin-right: calc(2.75rem + var(--space-xl));
    }

    .service__description {
      grid-column: 2;
      grid-row: 1;
    }

    .service__features {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .service__body :global(.btn) {
      grid-column: 2;
    }
  }

  .service__description {
    max-width: 48ch;
  }

  .service__features {
    display: grid;
    gap: 0 var(--space-xl);
    width: 100%;
  }

  @media (min-width: 640px) {
    .service__features {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service__features li {
    padding: var(--space-sm) 0 var(--space-sm) var(--space-lg);
    border-top: 1px solid var(--line);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    position: relative;
  }

  .service__features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(var(--space-sm) + 0.5em);
    width: 0.6rem;
    height: 2px;
    background: var(--color-secondary);
  }
</style>
