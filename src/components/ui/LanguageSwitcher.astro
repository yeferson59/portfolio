---
import {
  getAlternateLocale,
  getLocalizedPath,
  localeLabels,
  getCurrentLocale,
  type Locale,
} from "@/utils/i18n";

/**
 * Language Switcher Component
 * Displays a link to switch between available languages
 */

// Get current locale from Astro context
const currentLocale = getCurrentLocale(Astro.currentLocale);

// Get the alternate locale
const alternateLocale = getAlternateLocale(currentLocale);

// Get current path without locale prefix
const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/^\/(es\/)?/, "");

// Generate URL for alternate locale
const alternateUrl = getLocalizedPath(alternateLocale, currentPath);

// Get labels
const currentLabel = localeLabels[currentLocale];
const alternateLabel = localeLabels[alternateLocale];

// Short codes shown in the toggle
const codes: Record<Locale, string> = {
  en: "EN",
  es: "ES",
};
---

<div class="language-switcher" role="group" aria-label="Language">
  <span class="language-switcher__current" aria-current="true">
    <span class="visually-hidden">{currentLabel}</span>
    <span aria-hidden="true">{codes[currentLocale]}</span>
  </span>
  <a
    href={alternateUrl}
    class="language-switcher__option"
    hreflang={alternateLocale}
    aria-label={`Switch to ${alternateLabel}`}
  >
    {codes[alternateLocale]}
  </a>
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    height: 2.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .language-switcher > * {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 0 0.6rem;
  }

  .language-switcher__current {
    background: var(--color-text-primary);
    color: var(--color-background);
  }

  .language-switcher__option {
    color: var(--color-text-secondary);
    min-width: 2.75rem;
  }

  .language-switcher__option:hover {
    color: var(--color-text-primary);
  }
</style>
