---
import SectionHeader from "@/components/layouts/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import { contactMethods, developer } from "@/data/site";

const heading = "Get in touch";
const subtitle =
  "Have a project in mind? Let's talk about architecture, APIs or infrastructure. I reply within 24 hours.";

// Email gets the headline treatment; the other channels list beneath it.
const [emailUser, emailDomain] = developer.email.split("@");
const otherChannels = contactMethods.filter(
  (method) => method.label !== "Email",
);
---

<section id="contact">
  <div class="container">
    <SectionHeader title={heading} subtitle={subtitle} span="contact" />

    <div class="contact-grid">
      <div class="contact-direct">
        <a class="contact-email" href={`mailto:${developer.email}`}>
          {emailUser}
          <wbr />@{emailDomain}
        </a>

        <dl class="contact-channels">
          {otherChannels.map((method) => (
            <div>
              <dt>{method.label}</dt>
              <dd>
                <a
                  href={method.action}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Contact via ${method.label}: ${method.value} (opens in new tab)`}
                >
                  {method.value}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="contact-form-wrap">
        <h3 class="contact-form-wrap__title">Or send a message</h3>
        <form class="contact-form" novalidate>
          <div class="contact-form__pair">
            <div class="form-group">
              <label for="name" class="form-label">
                Name*
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Your name"
                class="form-input"
                aria-describedby="name-error"
                aria-invalid="false"
              />
              <div
                id="name-error"
                class="form-error"
                role="alert"
                aria-live="polite"
              ></div>
            </div>
            <div class="form-group">
              <label for="email" class="form-label">
                Email*
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="your@email.com"
                class="form-input"
                aria-describedby="email-error"
                aria-invalid="false"
              />
              <div
                id="email-error"
                class="form-error"
                role="alert"
                aria-live="polite"
              ></div>
            </div>
          </div>

          <div class="form-group">
            <label for="subject" class="form-label">
              Subject*
            </label>
            <input
              id="subject"
              name="subject"
              type="text"
              required
              placeholder="What would you like to talk about?"
              class="form-input"
              aria-describedby="subject-error"
              aria-invalid="false"
            />
            <div
              id="subject-error"
              class="form-error"
              role="alert"
              aria-live="polite"
            ></div>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">
              Message*
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="Tell me about your project..."
              class="form-input form-textarea"
              aria-describedby="message-error"
              aria-invalid="false"
            ></textarea>
            <div
              id="message-error"
              class="form-error"
              role="alert"
              aria-live="polite"
            ></div>
          </div>

          <div class="contact-form__submit">
            <Button type="submit" size="lg" aria-describedby="submit-status">
              Send message
            </Button>
            <p>I'll only use your email to reply.</p>
          </div>
          <div
            id="submit-status"
            class="form-status"
            role="status"
            aria-live="polite"
          ></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-4xl);
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-4xl);
    }
  }

  .contact-email {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-weight-extrabold);
    font-variation-settings: "wdth" 52;
    font-size: clamp(2.25rem, 0.6rem + 6.4vw, 5.5rem);
    line-height: 0.95;
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
    margin-bottom: var(--space-3xl);
  }

  .contact-email:hover {
    color: var(--color-primary);
  }

  .contact-channels > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: center;
    min-height: 3.25rem;
    border-top: 1px solid var(--line);
  }

  .contact-channels > div:last-child {
    border-bottom: 1px solid var(--line);
  }

  .contact-channels dt {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .contact-channels a {
    color: var(--color-text-primary);
  }

  .contact-channels a:hover {
    color: var(--color-primary);
  }

  .contact-form-wrap__title {
    font-size: var(--font-size-2xl);
    font-variation-settings: "wdth" 72;
    margin-bottom: var(--space-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-form__pair {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .contact-form__pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-form__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }

  .contact-form__submit p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
