---
import SectionHeader from "@/components/layouts/SectionHeader.astro";
import { skills } from "@/data/site";

// Levels tuned from GitHub activity (repos in TS/Node, Go, Python, Rust,
// infra). They only order each tier; the tier itself carries the meaning.
const levelMap: Record<string, number> = {
  // Expert core stack
  "Node.js": 95,
  TypeScript: 95,
  "Express.js": 92,
  PostgreSQL: 90,
  Docker: 90,
  "JWT Authentication": 92,
  "RESTful APIs": 92,
  JavaScript: 90,
  Git: 85,

  // Proficient ecosystem
  Golang: 80,
  Fiber: 75,
  Gin: 72,
  Redis: 80,
  Microservices: 82,
  "Better-Auth": 70,
  "Drizzle ORM": 76,
  "Docker Swarm": 72,
  WebSocket: 75,
  gRPC: 72,
  "Bun.js": 68,
  NestJS: 72,
  Python: 68,
  Rust: 62,
  "Next.js": 72,
  Astro: 70,
  TailwindCSS: 72,
  Makefile: 65,

  // Familiar & tools
  "C#": 55,
  Java: 58,
  "GitHub Actions": 62,
  "Swagger/OpenAPI": 62,
  "Jest Testing": 58,
  ESLint: 62,
  "NPM Publishing": 58,
  Prettier: 62,
  Husky: 62,
  Commitlint: 62,
  Django: 58,
  PLpgSQL: 68,
  "Shell Scripting": 68,
  WordPress: 55,
  "Machine Learning": 55,
  "AI/Gemini API": 65,
};

const byLevel = (names: readonly string[]) =>
  [...names].sort((a, b) => (levelMap[b] ?? 60) - (levelMap[a] ?? 60));

const tiers = [
  {
    key: "core",
    title: "Core stack",
    note: "What I reach for first and ship to production.",
    skills: byLevel(skills.expert),
  },
  {
    key: "ecosystem",
    title: "Ecosystem",
    note: "Used in real projects, comfortable owning.",
    skills: byLevel(skills.proficient),
  },
  {
    key: "familiar",
    title: "Familiar",
    note: "Tools and platforms I've worked with.",
    skills: byLevel(skills.familiar),
  },
];
---

<section id="skills">
  <div class="container">
    <SectionHeader
      title="Technical skills"
      subtitle="Grouped by how deep I go: the core stack I build production systems with, the ecosystem around it, and tools I've used along the way."
      span="skills"
    />

    <div class="skill-tiers">
      {tiers.map((tier) => (
        <div class={`skill-tier skill-tier--${tier.key}`}>
          <div class="skill-tier__head">
            <h3 class="skill-tier__title">{tier.title}</h3>
            <p class="skill-tier__note">{tier.note}</p>
          </div>
          <ul class="skill-tier__list">
            {tier.skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-tier {
    display: grid;
    gap: var(--space-md) var(--space-2xl);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--line-strong);
  }

  .skill-tier:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  @media (min-width: 900px) {
    .skill-tier {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      padding: var(--space-2xl) 0;
    }
  }

  .skill-tier__title {
    font-size: var(--font-size-2xl);
    font-variation-settings: "wdth" 72;
    margin-bottom: var(--space-xs);
  }

  .skill-tier__note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    max-width: 28ch;
  }

  .skill-tier__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.9em;
  }

  /* Type size carries the depth: the core stack is set as display type,
     the ecosystem mid-size, familiar tools as plain text. */
  .skill-tier--core .skill-tier__list {
    font-family: var(--font-display);
    font-weight: var(--font-weight-extrabold);
    font-variation-settings: "wdth" 55;
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.25rem);
    line-height: 1;
    color: var(--color-text-primary);
    gap: 0.05em 0.45em;
  }

  .skill-tier--ecosystem .skill-tier__list {
    font-family: var(--font-display);
    font-weight: var(--font-weight-semibold);
    font-variation-settings: "wdth" 70;
    font-size: clamp(1.35rem, 1rem + 1.2vw, 1.9rem);
    line-height: 1.25;
    color: var(--color-text-secondary);
  }

  .skill-tier--familiar .skill-tier__list {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    gap: 0.35em 1.25em;
  }
</style>
