---
/**
 * Single KPI card for the metrics section: title, value and a short
 * status note.
 */
import Card from "@/components/ui/Card.astro";

interface Props {
  title: string;
  value: string;
  /** Kept for data compatibility; the card no longer draws icons. */
  icon?: string;
  iconTone?: "primary" | "secondary";
  badgeVariant: "primary" | "secondary";
  badgeLabel: string;
}

const { title, value, badgeVariant, badgeLabel } = Astro.props;
---

<Card variant="compact" class="metrics-card" hover={false}>
  <h3 class="metrics-card__title">{title}</h3>
  <p class="metrics-card__value">{value}</p>
  <p class={`metrics-card__note metrics-card__note--${badgeVariant}`}>
    {badgeLabel}
  </p>
</Card>

<style>
  .metrics-card__title {
    font-family: var(--font-body);
    font-variation-settings: normal;
    font-stretch: 100%;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .metrics-card__value {
    font-family: var(--font-display);
    font-weight: var(--font-weight-extrabold);
    font-variation-settings: "wdth" 60;
    font-size: clamp(2.5rem, 1.8rem + 2vw, 3.5rem);
    line-height: 1;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
  }

  .metrics-card__note {
    font-size: var(--font-size-sm);
    color: var(--color-primary);
  }

  .metrics-card__note--secondary {
    color: var(--color-secondary);
  }
</style>
