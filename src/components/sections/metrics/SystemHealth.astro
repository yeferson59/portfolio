---
/**
 * System health summary rows (connections, error rate, throughput, load).
 */
interface Props {
  metrics: {
    activeConnections: number;
    errorRate: number;
    throughput: number;
    avgLoad: number;
  };
}

const { metrics } = Astro.props;

const rows = [
  { label: "Active Connections", value: `${metrics.activeConnections}` },
  { label: "Error Rate", value: `${metrics.errorRate}%` },
  { label: "Throughput", value: `${metrics.throughput} req/min` },
  { label: "Average Load", value: `${metrics.avgLoad}%` },
];
---

<div class="system-health">
  {
    rows.map((row) => (
      <div class="metric-row">
        <span class="text-secondary">{row.label}</span>
        <span class="text-primary font-semibold">{row.value}</span>
      </div>
    ))
  }
</div>

<style>
  .system-health {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .metric-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .metric-row:last-child {
    border-bottom: none;
  }
</style>
