---
/**
 * Response viewer panel: status, metrics and tabbed body/headers/code
 * views. Content is filled in client-side by the explorer controller
 * (src/scripts/api-explorer) after a request completes.
 */
import TabPanel from "@/components/api-explorer/ui/TabPanel.astro";
import StatusIndicator from "@/components/api-explorer/response/StatusIndicator.astro";
import MetricsPanel from "@/components/api-explorer/response/MetricsPanel.astro";
import ResponseViewer from "@/components/api-explorer/response/ResponseViewer.astro";

const responseTabs = [
  { id: "response", label: "Response", icon: "📄" },
  { id: "headers-response", label: "Headers", icon: "📋" },
  { id: "code-gen", label: "Code", icon: "💻" },
];
---

<div class="response-panel">
  <div class="panel-header">
    <h3 class="panel-title">Response</h3>
  </div>

  <!-- Status and Metrics will be shown when there's a response -->
  <div
    id="response-status-container"
    class="response-status-container"
    style="display: none;"
  >
    <StatusIndicator className="response-status" />
  </div>

  <div
    id="response-metrics-container"
    class="response-metrics-container"
    style="display: none;"
  >
    <MetricsPanel className="response-metrics" />
  </div>

  <!-- Response Tabs -->
  <div
    id="response-tabs-container"
    class="response-tabs-container"
    style="display: none;"
  >
    <TabPanel tabs={responseTabs} defaultTab="response">
      <div data-tab-panel-content="response" class="response-content-tab">
        <div id="response-body-content"></div>
      </div>

      <div
        data-tab-panel-content="headers-response"
        class="response-headers-tab"
      >
        <div id="response-headers-content"></div>
      </div>

      <div data-tab-panel-content="code-gen" class="response-code-tab">
        <div class="tab-header">
          <h4 class="tab-title">Generated Code</h4>
          <div class="tab-actions">
            <select
              class="response-code-lang-select"
              data-response-code-language
            >
              <option value="curl">cURL</option>
              <option value="javascript">JavaScript</option>
              <option value="python">Python</option>
              <option value="go">Go</option>
              <option value="php">PHP</option>
              <option value="java">Java</option>
              <option value="ruby">Ruby</option>
            </select>
            <button
              type="button"
              class="btn-generate-response"
              data-generate-response-code>🔄 Generate</button
            >
          </div>
        </div>
        <div id="response-code-content"></div>
      </div>
    </TabPanel>
  </div>

  <!-- Default empty state -->
  <div id="response-empty-state" class="response-empty-state">
    <ResponseViewer />
  </div>
</div>

<style>
  .response-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .panel-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  /* Tabs */
  .response-tabs-container {
    background: var(--color-bg-tertiary);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .tab-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tab-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .tab-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .response-code-lang-select {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    color: var(--color-text-primary);
    margin-right: 0.5rem;
  }

  .btn-generate-response {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    border: 1px solid var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
    color: var(--color-primary);
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-generate-response:hover {
    background: rgba(var(--color-primary-rgb), 0.2);
  }

  /* Content areas (filled client-side by the explorer controller) */
  #response-body-content,
  #response-headers-content {
    padding: 1rem;
    max-height: 60vh;
    overflow: auto;
  }

  /*
   * Everything below targets markup injected via innerHTML, which
   * doesn't carry Astro's scoping attribute — hence :global() anchored
   * to the static container ids above.
   */

  /* Response body (JSON viewer) */
  #response-body-content :global(.json-viewer) {
    position: relative;
  }

  #response-body-content :global(.json-content) {
    font-family: "Monaco", "Menlo", monospace;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
    padding: 1rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    overflow-x: auto;
    white-space: pre;
  }

  #response-body-content :global(.empty-body) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    background: var(--color-bg-secondary);
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
  }

  /* Headers table */
  #response-headers-content :global(.headers-table) {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  #response-headers-content :global(.headers-table table) {
    width: 100%;
    border-collapse: collapse;
  }

  #response-headers-content :global(.headers-table th) {
    background: var(--color-bg-secondary);
    padding: 0.75rem;
    text-align: left;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
  }

  #response-headers-content :global(.headers-table td) {
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  #response-headers-content :global(.headers-table tbody tr:last-child td) {
    border-bottom: none;
  }

  #response-headers-content :global(.headers-table tbody tr:hover) {
    background: var(--color-bg-hover);
  }

  #response-headers-content :global(.header-name code),
  #response-headers-content :global(.header-value code) {
    font-family: "Monaco", "Menlo", monospace;
    font-size: 0.8125rem;
    color: var(--color-text-primary);
    background: transparent;
  }

  #response-headers-content :global(.header-name code) {
    font-weight: 600;
    color: var(--color-primary);
  }

  #response-headers-content :global(.copy-header-btn) {
    padding: 0.25rem;
    font-size: 0.75rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  #response-headers-content :global(.copy-header-btn:hover) {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  #response-headers-content :global(.empty-headers) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    background: var(--color-bg-secondary);
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .response-panel {
      padding: 1rem;
    }

    .tab-header {
      flex-direction: column;
      gap: 1rem;
      align-items: stretch;
    }

    .tab-actions {
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    #response-headers-content :global(.headers-table) {
      font-size: 0.8125rem;
    }

    #response-headers-content :global(.headers-table th),
    #response-headers-content :global(.headers-table td) {
      padding: 0.5rem;
    }
  }
</style>
