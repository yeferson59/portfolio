---
/**
 * API Explorer - Main Component
 * Orchestrates the interactive API testing interface: API/endpoint
 * selection plus the request builder and response viewer panels.
 */

import { availableAPIs } from "@/utils/api-explorer/config";
import RequestPanel from "./RequestPanel.astro";
import ResponsePanel from "./ResponsePanel.astro";

interface Props {
  defaultAPI?: string;
  className?: string;
}

const { defaultAPI = availableAPIs[0]?.id, className = "" } = Astro.props;
---

<div id="api-explorer" class={`api-explorer ${className}`} data-api-explorer>
  <!-- API and Endpoint Selection -->
  <div class="explorer-header">
    <div class="api-selector-group">
      <label for="api-select" class="selector-label">API</label>
      <select id="api-select" class="api-select" data-api-select>
        {
          availableAPIs.map((api) => (
            <option value={api.id} selected={api.id === defaultAPI}>
              {api.name} v{api.version}
            </option>
          ))
        }
      </select>
    </div>

    <div class="endpoint-selector-group">
      <label for="endpoint-select" class="selector-label">Endpoint</label>
      <select id="endpoint-select" class="endpoint-select" data-endpoint-select>
        <option value="">Select an endpoint...</option>
      </select>
    </div>
  </div>

  <!-- Main Explorer Layout -->
  <div class="explorer-layout">
    <RequestPanel />
    <ResponsePanel />
  </div>
</div>

<style>
  .api-explorer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--color-bg-primary);
    border-radius: 1rem;
    border: 1px solid var(--color-border);
  }

  /* Header */
  .explorer-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1rem;
  }

  .api-selector-group,
  .endpoint-selector-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .selector-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .api-select,
  .endpoint-select {
    padding: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .api-select:hover,
  .endpoint-select:hover {
    border-color: var(--color-primary);
  }

  .api-select:focus,
  .endpoint-select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.1);
  }

  /* Main Layout */
  .explorer-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  /*
   * Code blocks generated client-side (request and response panels)
   * are injected via innerHTML, so they don't carry Astro's scoping
   * attribute. These :global() rules mirror CodeBlock.astro so the
   * generated snippets look like the real component.
   */
  .api-explorer :global(.code-block) {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg-secondary);
    overflow: hidden;
  }

  .api-explorer :global(.code-block-header) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg-tertiary);
    border-bottom: 1px solid var(--color-border);
  }

  .api-explorer :global(.code-block-title) {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .api-explorer :global(.code-block-language) {
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
    border-radius: 0.25rem;
    text-transform: uppercase;
  }

  .api-explorer :global(.code-block-copy) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .api-explorer :global(.code-block-copy:hover) {
    color: var(--color-primary);
    background: var(--color-bg-hover);
    border-color: var(--color-primary);
  }

  .api-explorer :global(.code-block-content) {
    overflow: auto;
  }

  .api-explorer :global(.code-pre) {
    margin: 0;
    padding: 1rem;
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  .api-explorer :global(.code-text) {
    display: block;
    white-space: pre;
    word-wrap: normal;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .explorer-layout {
      grid-template-columns: 1fr;
    }

    .explorer-header {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .api-explorer {
      padding: 1rem;
    }
  }
</style>

<script>
  import { initAPIExplorer } from "@/scripts/api-explorer";
  initAPIExplorer();
</script>
