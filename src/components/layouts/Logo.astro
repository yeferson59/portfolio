---
import { developer } from "@/data/site";

interface Props {
  showText?: boolean;
  class?: string;
}

const { showText = true, class: className = "" } = Astro.props;

const [firstName, lastName] = developer.name.split(" ");
const initials = `${firstName[0]}${lastName[0]}`;
---

<a
  href="/"
  class={`header__logo ${className}`}
  aria-label={`${firstName} ${lastName}, home`}
>
  <span class="header__mark" aria-hidden="true">
    {initials}
  </span>
  {showText && (
    <span class="header__name">
      {firstName} {lastName}
    </span>
  )}
</a>
