---
import {
  developer,
  navigationLinks,
  socialLinks,
  meta,
  footerLinks,
} from "@/data/site";

const [firstName, lastName] = developer.name.split(" ");
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <p class="footer__title">{developer.title}</p>
        <p class="footer__text">
          Based in {developer.location}. Working in English and Spanish.
        </p>
      </div>

      <div>
        <h2 class="footer__heading">Sections</h2>
        <ul class="footer__list">
          {navigationLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer__heading">Elsewhere</h2>
        <ul class="footer__list">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${social.label} profile (opens in new tab)`}
              >
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <p>{meta.copyright}</p>
      <ul>
        <li>
          <a href={footerLinks.terms}>Terms</a>
        </li>
        <li>
          <a href={footerLinks.privacy}>Privacy</a>
        </li>
        <li>
          <a href={footerLinks.licenses}>Licenses</a>
        </li>
      </ul>
    </div>

    <p class="footer__signature" aria-hidden="true">
      {firstName} {lastName}
    </p>
  </div>
</footer>

<style>
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl) var(--space-lg);
  }

  .footer__grid > :first-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 3fr) minmax(0, 3fr);
    }

    .footer__grid > :first-child {
      grid-column: auto;
    }
  }

  .footer__title {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-variation-settings: "wdth" 72;
    font-size: var(--font-size-2xl);
    line-height: 1.15;
    color: var(--color-text-primary);
    max-width: 24ch;
    margin-bottom: var(--space-sm);
  }

  .footer__text {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .footer__list {
    display: grid;
    gap: var(--space-2xs);
  }

  .footer__list a,
  .footer__legal a {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .footer__list a {
    display: inline-block;
    padding: var(--space-2xs) 0;
  }

  .footer__list a:hover,
  .footer__legal a:hover {
    color: var(--color-text-primary);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-3xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line);
    font-size: var(--font-size-sm);
  }

  .footer__legal p {
    color: var(--color-text-muted);
  }

  .footer__legal ul {
    display: flex;
    gap: var(--space-lg);
  }
</style>
