{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "http-server .vercel/output/static -p 4321 -s",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint \"src/**/*.{js,ts,astro}\" \"**/*.md\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,astro}\" \"**/*.md\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,astro}\" \"**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,astro}\" \"**/*.md\""
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/vercel": "11.0.11",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@tailwindcss/vite": "4.3.3",
    "@vercel/speed-insights": "2.0.0",
    "astro": "7.3.5",
    "better-auth": "1.7.6",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/ui": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "http-server": "14.1.1",
    "jiti": "2.7.0",
    "vitest": "5.0.2"
  }
}
